{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving aggregation for smart grids",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude test/exactness.test.ts",
    "test:exactness": "vitest run test/exactness.test.ts",
    "typecheck": "tsc --noEmit",
    "e1": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e1.ts",
    "e2": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e2.ts",
    "e3": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e3.ts",
    "e4": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e4.ts",
    "e7": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e7.ts",
    "e8": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e8.ts",
    "claims": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/claims.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1"
  }
}
