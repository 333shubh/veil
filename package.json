{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-preserving aggregation for smart grids",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --exclude test/exactness.test.ts",
    "test:exactness": "vitest run test/exactness.test.ts",
    "typecheck": "tsc --noEmit",
    "e1": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e1.ts",
    "e2": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e2.ts",
    "e3": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e3.ts",
    "e4": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e4.ts",
    "e7": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e7.ts",
    "e8": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e8.ts",
    "e9": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e9.ts",
    "claims": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/claims.ts",
    "india-dropout": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/india-dropout.ts",
    "load-validation": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/load-validation.ts",
    "e5": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e5.ts",
    "e6": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/e6.ts",
    "indistinguishability": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/indistinguishability.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning demo/build.ts --serve",
    "demo:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning demo/build.ts",
    "demo:soak": "npm run demo:build && node demo/dist/soak.mjs",
    "trace": "node --experimental-strip-types --disable-warning=ExperimentalWarning experiments/trace.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "0.186.0",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "lenis": "1.3.26",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  }
}
